create table if not exists public.user_entitlements (
  user_id uuid primary key references auth.users(id) on delete cascade,
  plan_key text not null,
  plan_name text not null,
  questions_remaining integer not null default 0 check (questions_remaining >= 0),
  compatibility_remaining integer not null default 0 check (compatibility_remaining >= 0),
  analyses_avulsas jsonb not null default '[]'::jsonb,
  weekly_week text,
  weekly_used integer not null default 0 check (weekly_used >= 0),
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create index if not exists user_entitlements_user_idx on public.user_entitlements (user_id);

alter table public.user_entitlements enable row level security;

create policy "user_entitlements_select_own" on public.user_entitlements
  for select to authenticated using (auth.uid() = user_id);

create or replace function public.grant_plan_entitlements(p_user_id uuid, p_product_id text)
returns void
language plpgsql
security definer set search_path = public
as $$
declare
  v_plan_key text;
  v_plan_name text;
  v_questions integer;
  v_compat integer;
  v_analyses jsonb;
begin
  if p_user_id is null then
    return;
  end if;

  -- Mapa Natal Completo (R$17)
  if p_product_id = 'prod_VIPSTE2jPvpulW' then
    v_plan_key := 'mapa17';
    v_plan_name := 'Mapa Natal Completo';
    v_questions := 3;
    v_compat := 0;
    v_analyses := '["s1"]'::jsonb;
  -- Guia Mensal / assinatura (R$97)
  elsif p_product_id = 'prod_VDub44DMiyL80u' then
    v_plan_key := 'assinatura97';
    v_plan_name := 'Guia Mensal';
    v_questions := 0;
    v_compat := 4;
    v_analyses := '[]'::jsonb;
  -- Acesso Total (R$147)
  elsif p_product_id = 'prod_VIPSYxrjRH8vci' then
    v_plan_key := 'total147';
    v_plan_name := 'Acesso Total às Análises';
    v_questions := 10;
    v_compat := 0;
    v_analyses := '["s1","s2","s3","s4","s5"]'::jsonb;
  else
    return;
  end if;

  insert into public.user_entitlements (user_id, plan_key, plan_name, questions_remaining, compatibility_remaining, analyses_avulsas)
  values (p_user_id, v_plan_key, v_plan_name, v_questions, v_compat, v_analyses)
  on conflict (user_id)
  do update set
    plan_key = excluded.plan_key,
    plan_name = excluded.plan_name,
    questions_remaining = excluded.questions_remaining,
    compatibility_remaining = excluded.compatibility_remaining,
    analyses_avulsas = excluded.analyses_avulsas,
    updated_at = now();
end;
$$;

revoke execute on function public.grant_plan_entitlements(uuid, text) from public, anon, authenticated;
grant execute on function public.grant_plan_entitlements(uuid, text) to service_role;

create or replace function public.get_my_entitlements()
returns jsonb
language plpgsql
security definer set search_path = public
as $$
declare
  v_row public.user_entitlements%rowtype;
  v_current_week text := to_char(current_date, 'IYYY-IW');
begin
  select * into v_row from public.user_entitlements where user_id = auth.uid();
  if not found then
    return jsonb_build_object('has_plan', false);
  end if;
  return jsonb_build_object(
    'has_plan', true,
    'plan_key', v_row.plan_key,
    'plan_name', v_row.plan_name,
    'questions_remaining', v_row.questions_remaining,
    'compatibility_remaining', v_row.compatibility_remaining,
    'analyses_avulsas', v_row.analyses_avulsas,
    'weekly_available', v_row.plan_key = 'assinatura97' and coalesce(v_row.weekly_week, '') <> v_current_week or (v_row.plan_key = 'assinatura97' and v_row.weekly_used < 1),
    'weekly_used', case when v_row.plan_key = 'assinatura97' then v_row.weekly_used else 0 end
  );
end;
$$;

revoke execute on function public.get_my_entitlements() from public, anon;
grant execute on function public.get_my_entitlements() to authenticated;

create or replace function public.consume_terminal_question()
returns jsonb
language plpgsql
security definer set search_path = public
as $$
declare
  v_remaining integer;
begin
  select questions_remaining into v_remaining
  from public.user_entitlements where user_id = auth.uid();
  if not found then
    return jsonb_build_object('ok', false, 'error', 'no_plan');
  end if;
  if v_remaining <= 0 then
    return jsonb_build_object('ok', false, 'error', 'no_questions');
  end if;
  update public.user_entitlements
     set questions_remaining = questions_remaining - 1, updated_at = now()
   where user_id = auth.uid();
  return jsonb_build_object('ok', true, 'remaining', v_remaining - 1);
end;
$$;

revoke execute on function public.consume_terminal_question() from public, anon;
grant execute on function public.consume_terminal_question() to authenticated;

create or replace function public.consume_analysis(p_analysis_key text)
returns jsonb
language plpgsql
security definer set search_path = public
as $$
declare
  v_row public.user_entitlements%rowtype;
  v_current_week text := to_char(current_date, 'IYYY-IW');
  v_remaining jsonb;
begin
  select * into v_row from public.user_entitlements where user_id = auth.uid();
  if not found then
    return jsonb_build_object('ok', false, 'error', 'no_plan');
  end if;

  -- Análise avulsa comprada: remove da lista se existir
  if v_row.analyses_avulsas ? p_analysis_key then
    update public.user_entitlements
       set analyses_avulsas = v_row.analyses_avulsas - p_analysis_key, updated_at = now()
     where user_id = auth.uid();
    return jsonb_build_object('ok', true, 'kind', 'avulsa');
  end if;

  -- Assinatura: 1 análise por semana
  if v_row.plan_key = 'assinatura97' then
    if v_row.weekly_week = v_current_week and v_row.weekly_used >= 1 then
      return jsonb_build_object('ok', false, 'error', 'weekly_limit');
    end if;
    update public.user_entitlements
       set weekly_week = v_current_week, weekly_used = 1, updated_at = now()
     where user_id = auth.uid();
    return jsonb_build_object('ok', true, 'kind', 'semanal');
  end if;

  return jsonb_build_object('ok', false, 'error', 'not_available');
end;
$$;

revoke execute on function public.consume_analysis(text) from public, anon;
grant execute on function public.consume_analysis(text) to authenticated;

