-- Correção: row_to_jsonb(record) não existe no Postgres; usar to_jsonb().
-- Reimplantação das funções afetadas.

create or replace function public.list_public_members()
returns jsonb
language plpgsql
security definer set search_path = public
as $$
declare
  v_result jsonb;
begin
  select coalesce(jsonb_agg(to_jsonb(t) order by t.display_name), '[]'::jsonb)
  into v_result
  from (
    select
      p.id,
      p.display_name,
      p.bio,
      p.zodiac_sign,
      p.avatar_url,
      p.gender,
      p.sexuality,
      p.location,
      case when p.birth_date is not null
           then date_part('year', age(p.birth_date))::int
           else null end as age,
      (select count(*) from public.follows f where f.following_id = p.id) as followers,
      (select count(*) from public.follows f where f.follower_id = p.id) as following,
      exists(select 1 from public.follows f where f.follower_id = auth.uid() and f.following_id = p.id) as is_following
    from public.profiles p
    where p.social_visible = true and p.id <> auth.uid()
  ) t;
  return v_result;
end;
$$;

revoke execute on function public.list_public_members() from public, anon;
grant execute on function public.list_public_members() to authenticated;

create or replace function public.get_my_conversations()
returns jsonb
language plpgsql security definer set search_path = public
as $$
declare
  v_result jsonb;
begin
  select coalesce(jsonb_agg(to_jsonb(t) order by t.last_at desc nulls last), '[]'::jsonb)
  into v_result
  from (
    select
      p.id as partner_id,
      p.display_name,
      p.avatar_url,
      p.zodiac_sign,
      public.is_matched(auth.uid(), p.id) as matched,
      (select m.content from public.chat_messages m
        where (m.sender_id = auth.uid() and m.receiver_id = p.id)
           or (m.sender_id = p.id and m.receiver_id = auth.uid())
        order by m.created_at desc limit 1) as last_message,
      (select m.created_at from public.chat_messages m
        where (m.sender_id = auth.uid() and m.receiver_id = p.id)
           or (m.sender_id = p.id and m.receiver_id = auth.uid())
        order by m.created_at desc limit 1) as last_at,
      (select count(*) from public.chat_messages m
        where m.sender_id = p.id and m.receiver_id = auth.uid() and m.read_at is null) as unread
    from public.profiles p
    where p.id <> auth.uid()
      and exists (
        select 1 from public.chat_messages m
        where (m.sender_id = auth.uid() and m.receiver_id = p.id)
           or (m.sender_id = p.id and m.receiver_id = auth.uid())
      )
  ) t;
  return v_result;
end;
$$;

revoke execute on function public.get_my_conversations() from public, anon;
grant execute on function public.get_my_conversations() to authenticated;

create or replace function public.get_match_messages(p_partner_id uuid)
returns jsonb
language plpgsql security definer set search_path = public
as $$
declare
  v_result jsonb;
begin
  if not public.is_matched(auth.uid(), p_partner_id) then
    return jsonb_build_object('matched', false, 'messages', '[]'::jsonb);
  end if;

  select coalesce(jsonb_agg(to_jsonb(t) order by t.created_at), '[]'::jsonb)
  into v_result
  from (
    select m.id, m.sender_id, m.content, m.created_at, m.read_at
    from public.chat_messages m
    where (m.sender_id = auth.uid() and m.receiver_id = p_partner_id)
       or (m.sender_id = p_partner_id and m.receiver_id = auth.uid())
  ) t;

  update public.chat_messages set read_at = now()
  where sender_id = p_partner_id and receiver_id = auth.uid() and read_at is null;

  return jsonb_build_object('matched', true, 'messages', v_result);
end;
$$;

revoke execute on function public.get_match_messages(uuid) from public, anon;
grant execute on function public.get_match_messages(uuid) to authenticated;

create or replace function public.send_match_message(p_partner_id uuid, p_content text)
returns jsonb
language plpgsql security definer set search_path = public
as $$
declare
  v_msg record;
begin
  if p_content is null or length(trim(p_content)) = 0 then
    return jsonb_build_object('ok', false, 'error', 'empty');
  end if;
  if not public.is_matched(auth.uid(), p_partner_id) then
    return jsonb_build_object('ok', false, 'error', 'not_matched');
  end if;
  insert into public.chat_messages (sender_id, receiver_id, content)
  values (auth.uid(), p_partner_id, left(trim(p_content), 2000))
  returning id, sender_id, receiver_id, content, created_at, read_at into v_msg;
  return jsonb_build_object('ok', true, 'message', to_jsonb(v_msg));
end;
$$;

revoke execute on function public.send_match_message(uuid, text) from public, anon;
grant execute on function public.send_match_message(uuid, text) to authenticated;