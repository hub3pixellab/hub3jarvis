create table if not exists public.delivered_analyses (
  id uuid primary key default gen_random_uuid(),
  user_id uuid not null references auth.users(id) on delete cascade,
  analysis_key text not null,
  plan_key text,
  product_name text,
  content text not null,
  provider text,
  model text,
  created_at timestamptz not null default now()
);

create index if not exists delivered_analyses_user_idx on public.delivered_analyses (user_id, analysis_key);

create unique index if not exists delivered_analyses_user_key_uniq on public.delivered_analyses (user_id, analysis_key);

alter table public.delivered_analyses enable row level security;

create policy "delivered_analyses_select_own" on public.delivered_analyses
  for select to authenticated using (auth.uid() = user_id);