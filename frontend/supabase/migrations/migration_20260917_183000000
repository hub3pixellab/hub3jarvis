-- Increment 3: global analysis counter + Stripe webhook idempotency.
-- Baseline "4.200+" comes from the landing copy stat "Consultas realizadas".

-- 1) Singleton global counter, seeded to the landing-page baseline.
create table if not exists public.global_stats (
  id integer primary key check (id = 1),
  analysis_count bigint not null default 0,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

insert into public.global_stats (id, analysis_count)
values (1, 4200)
on conflict (id) do nothing;

alter table public.global_stats enable row level security;

-- Anyone (anon or authenticated) may read the public counter...
create policy "global_stats_select_public" on public.global_stats
  for select to anon, authenticated using (true);
-- ...but no client role may write: there is no insert/update/delete policy.
-- Only the service-role backend function may update the counter.

-- 2) Idempotency ledger for processed Stripe events (service-role only).
create table if not exists public.stripe_events (
  id text primary key,
  event_type text not null,
  session_id text,
  user_id uuid,
  processed_at timestamptz not null default now()
);

alter table public.stripe_events enable row level security;
-- No client policies: the ledger is written exclusively by the service-role webhook.

-- 3) Atomic counter increment (service-role only).
create or replace function public.increment_analysis_counter(p_count integer default 1)
returns bigint
language plpgsql
security definer set search_path = public
as $$
declare v_count bigint;
begin
  update public.global_stats
     set analysis_count = analysis_count + p_count,
         updated_at = now()
   where id = 1
  returning analysis_count into v_count;
  return v_count;
end;
$$;

revoke execute on function public.increment_analysis_counter(integer) from public, anon, authenticated;
grant execute on function public.increment_analysis_counter(integer) to service_role;

-- 4) Idempotent purchase recording: one purchase + one counter increment per Stripe
-- event id, so a replayed webhook never double-counts or duplicates the purchase.
create or replace function public.record_checkout_completion(
  p_event_id text,
  p_session_id text,
  p_user_id uuid,
  p_product_name text,
  p_price_centavos integer,
  p_product_id text default null
)
returns boolean
language plpgsql
security definer set search_path = public
as $$
declare
  v_is_new boolean;
begin
  -- Idempotency gate: the event id is the primary key; a replayed event inserts nothing.
  insert into public.stripe_events (id, event_type, session_id, user_id)
  values (p_event_id, 'checkout.session.completed', p_session_id, p_user_id)
  on conflict (id) do nothing;

  if not found then
    return false; -- already processed: never double-increment or duplicate the purchase
  end if;

  -- Record the purchase only when the checkout carried a valid authenticated owner.
  if p_user_id is not null then
    insert into public.purchased_analyses (user_id, product_name, price_centavos, status, metadata)
    values (
      p_user_id,
      p_product_name,
      p_price_centavos,
      'pago',
      jsonb_build_object(
        'stripe_event_id', p_event_id,
        'stripe_session_id', p_session_id,
        'stripe_product_id', p_product_id
      )
    );
  end if;

  perform public.increment_analysis_counter(1);
  return true;
end;
$$;

revoke execute on function public.record_checkout_completion(text, text, uuid, text, integer, text) from public, anon, authenticated;
grant execute on function public.record_checkout_completion(text, text, uuid, text, integer, text) to service_role;

-- 5) Optional realtime for the live counter.
alter publication supabase_realtime add table public.global_stats;
