-- Cache das leituras de combinação por signo (par + idioma).
-- Escrita/leitura apenas pela função de backend (service role); sem acesso de cliente.
create table if not exists public.compat_readings (
  pair text not null,
  lang text not null,
  sign1 text not null,
  sign2 text not null,
  score integer not null default 0,
  summary text,
  strengths text,
  challenges text,
  advice text,
  created_at timestamptz not null default now(),
  primary key (pair, lang)
);

alter table public.compat_readings enable row level security;
-- Sem políticas para clientes: somente a função de backend (service role) acessa.